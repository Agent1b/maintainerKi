APP_ENV=production
LOG_LEVEL=INFO
DEBUG_API_ENABLED=false

POSTGRES_USER=maintainerki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maintainerki
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8080
APP_DOMAIN=maintainerki.example.com
ACME_EMAIL=you@example.com

GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_APP_ID=replace-me
# Absolute path on the host machine.
GITHUB_PRIVATE_KEY_HOST_PATH=/absolute/path/to/maintainerki.private-key.pem
# Inside the containers, this path must exist because the private key is bind-mounted there.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/maintainerki.private-key.pem
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_LABEL_WRITEBACK_ENABLED=true
GITHUB_AUTO_CREATE_LABELS=true
GITHUB_WRITEBACK_TIMEOUT_SECONDS=30
GITHUB_DUPLICATE_COMMENTS_ENABLED=true
CELERY_WORKER_CONCURRENCY=2

# Leave blank to monitor every repo the app is installed on.
MONITORED_REPOSITORIES=

# Scoring provider options:
SCORER_PROVIDER=ollama
SCORER_TIMEOUT_SECONDS=60
SCORER_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m
INSTALL_SEMANTIC_DUPLICATES=false

# Duplicate detection:
DUPLICATE_EMBEDDING_PROVIDER=hashing
DUPLICATE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.80
DUPLICATE_MAX_CANDIDATES=3
DUPLICATE_LABEL_NAME=maintainerki:possible-duplicate

# Dashboard/API:
DASHBOARD_ALLOWED_ORIGINS=http://localhost:8080,https://maintainerki.example.com

# Label thresholds:
SUSPICIOUS_SCORE_THRESHOLD=70
NEEDS_INFO_COMPLETENESS_THRESHOLD=40
REVIEW_FIRST_THRESHOLD=80
WORTH_A_LOOK_THRESHOLD=55
