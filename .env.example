APP_NAME=maintainerKi
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
EXPOSE_API_DOCS=true
DETAILED_PUBLIC_HEALTH=true
TRUSTED_HOSTS=
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Local-only fallback if you do not want to generate a hash yet:
# ADMIN_PASSWORD=change-me
SESSION_SECRET=
SESSION_NOT_BEFORE_EPOCH=0
SESSION_COOKIE_NAME=maintainerki_session
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
WEBHOOK_RATE_LIMIT_REQUESTS=240
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
DEBUG_API_ENABLED=true

GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_LABEL_WRITEBACK_ENABLED=true
GITHUB_AUTO_CREATE_LABELS=true
GITHUB_WRITEBACK_TIMEOUT_SECONDS=30
GITHUB_DUPLICATE_COMMENTS_ENABLED=true
MONITORED_REPOSITORIES=

SCORER_PROVIDER=ollama
SCORER_TIMEOUT_SECONDS=60
SCORER_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b
# Apple Silicon / MLX example:
# OLLAMA_MODEL=qwen3.6:27b-mlx
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m

# Direct MLX example (raw Hugging Face cache / mlx-lm):
# SCORER_PROVIDER=mlx
# MLX_COMMAND=./.venv-mlx/bin/mlx_lm.generate
# MLX_MODEL_PATH=/path/to/mlx-model-snapshot
# MLX_MAX_TOKENS=300
# MLX_USE_DEFAULT_CHAT_TEMPLATE=false

# Start the local Postgres container with: make infra-up
DATABASE_URL=postgresql://maintainerki:maintainerki_dev_password@localhost:5432/maintainerki
REDIS_URL=redis://localhost:6379/0
QUEUE_PROVIDER=celery
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

DUPLICATE_EMBEDDING_PROVIDER=hashing
# Recommended semantic provider for Phase 3:
# DUPLICATE_EMBEDDING_PROVIDER=sentence-transformers
# DUPLICATE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DUPLICATE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.80
DUPLICATE_MAX_CANDIDATES=3
DUPLICATE_LABEL_NAME=maintainerki:possible-duplicate
DUPLICATE_HASH_DIMENSIONS=384
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_RETENTION_DAYS=30
CONTRIBUTION_BODY_RETENTION_DAYS=90
FEEDBACK_NOTE_RETENTION_DAYS=365
SUSPICIOUS_SCORE_THRESHOLD=70
NEEDS_INFO_COMPLETENESS_THRESHOLD=40
REVIEW_FIRST_THRESHOLD=80
WORTH_A_LOOK_THRESHOLD=55
